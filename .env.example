# ==================== Inference service (GPU) ====================
# HF repo id OR local path to fine-tuned SecBERT checkpoint.
SECBERT_MODEL_PATH=issssssaaaa/secbert-siem

# URL of the inference service (agent side).
INFERENCE_SERVICE_URL=http://localhost:8001

# Bearer token shared between agent and inference service.
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(32))"
INFERENCE_SERVICE_API_KEY=changeme

# Optional HuggingFace token (if model is private).
# HF_TOKEN=

# ==================== LLM (Cloud via LiteLLM) =====================
# Any LiteLLM-supported model id.
# Examples: anthropic/claude-haiku-4-5, openai/gpt-4o-mini, deepseek/deepseek-chat
#
# OpenRouter examples (prefix: openrouter/):
#   openrouter/google/gemini-2.5-flash
#   openrouter/meta-llama/llama-4-maverick
#   openrouter/mistralai/mistral-medium-3
#   openrouter/anthropic/claude-haiku-4-5
#   openrouter/qwen/qwen3-235b-a22b
LLM_MODEL=anthropic/claude-haiku-4-5

# Set one of these (LiteLLM reads them from env directly).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# OpenRouter app identification (optional, shows in dashboard).
# OPENROUTER_APP_NAME=soc-agent
# OPENROUTER_SITE_URL=

LLM_MAX_CONCURRENT=5
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60

# ==================== RAG =========================================
CHROMA_PERSIST_DIR=./data/chroma
PLAYBOOKS_DIR=./playbooks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==================== Pipeline ====================================
CACHE_DIR=./data/cache
BATCH_SIZE=64
HDBSCAN_MIN_CLUSTER_SIZE=5
HDBSCAN_MIN_SAMPLES=3

# ==================== Logging =====================================
LOG_LEVEL=INFO
